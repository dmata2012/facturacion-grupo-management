# Dependencias
node_modules/
backend/node_modules/

# Variables de entorno y secretos — nunca versionar
.env
.env.*
backend/.env
*.env

# Archivos subidos por usuarios
backend/uploads/
uploads/

# Respaldos de base de datos
*.sql
respaldos/

# ...pero las migraciones del CRM sí son código: sin ellas, quien clone el
# repo no puede levantar la base. La regla de arriba, pensada para los
# respaldos del sistema de facturación, se las estaba tragando.
!crm/prisma/migrations/**/*.sql

# Logs
*.log
npm-debug.log*

# Sistema
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
